#!/usr/bin/env python3
"""Generate deterministic OpenAPI and TypeScript schema artifacts."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "agent"))

from api_server import app  # noqa: E402


def ts_type(schema: dict[str, Any]) -> str:
    if "$ref" in schema:
        return schema["$ref"].rsplit("/", 1)[-1]
    if "anyOf" in schema:
        return " | ".join(dict.fromkeys(ts_type(item) for item in schema["anyOf"]))
    if "enum" in schema:
        return " | ".join(json.dumps(value, ensure_ascii=False) for value in schema["enum"])
    kind = schema.get("type")
    if kind == "string":
        return "string"
    if kind in {"integer", "number"}:
        return "number"
    if kind == "boolean":
        return "boolean"
    if kind == "null":
        return "null"
    if kind == "array":
        return f"Array<{ts_type(schema.get('items', {}))}>"
    if kind == "object" or "properties" in schema:
        additional = schema.get("additionalProperties")
        if additional is True:
            return "Record<string, unknown>"
        if isinstance(additional, dict):
            return f"Record<string, {ts_type(additional)}>"
        properties = schema.get("properties", {})
        required = set(schema.get("required", []))
        fields = [
            f"{json.dumps(name)}{'?' if name not in required else ''}: {ts_type(value)}"
            for name, value in properties.items()
        ]
        return "{ " + "; ".join(fields) + " }"
    return "unknown"


def render_types(schema: dict[str, Any]) -> str:
    schemas = schema.get("components", {}).get("schemas", {})
    lines = [
        "// Generated by scripts/generate-api-contracts. Do not edit manually.",
        "/* eslint-disable */",
        "",
    ]
    for name, definition in sorted(schemas.items()):
        rendered = ts_type(definition)
        if rendered.startswith("{ "):
            lines.append(f"export type {name} = {rendered};")
        else:
            lines.append(f"export type {name} = {rendered};")
    lines.extend(
        [
            "",
            "export interface components {",
            "  schemas: {",
            *[f"    {json.dumps(name)}: {name};" for name in sorted(schemas)],
            "  };",
            "}",
            "",
        ]
    )
    return "\n".join(lines)


def render_client(schema: dict[str, Any]) -> str:
    """Render a small generated operation registry and typed transport client."""
    operations: dict[str, dict[str, str]] = {}
    for path, path_item in sorted(schema.get("paths", {}).items()):
        if not path.startswith("/api/v1/"):
            continue
        for method in ("get", "post", "put", "patch", "delete"):
            operation = path_item.get(method)
            if not isinstance(operation, dict):
                continue
            operation_id = operation.get("operationId")
            if operation_id:
                operations[operation_id] = {"method": method.upper(), "path": path}
    payload = json.dumps(operations, ensure_ascii=False, indent=2, sort_keys=True)
    return "\n".join(
        [
            "// Generated by scripts/generate-api-contracts. Do not edit manually.",
            "/* eslint-disable */",
            "",
            f"export const apiOperations = {payload} as const;",
            "",
            "export type ApiOperationId = keyof typeof apiOperations;",
            "export interface GeneratedCallOptions {",
            "  path?: Record<string, string | number>;",
            "  query?: Record<string, string | number | boolean | undefined>;",
            "  body?: unknown;",
            "}",
            "",
            "export interface GeneratedRequest {",
            "  method: string;",
            "  path: string;",
            "  body?: unknown;",
            "}",
            "",
            "export function resolveGeneratedOperation(",
            "  operationId: ApiOperationId,",
            "  options: GeneratedCallOptions = {},",
            "): GeneratedRequest {",
            "  const operation = apiOperations[operationId];",
            "  let path = operation.path.replace(/\\{([^}]+)\\}/g, (_match, name: string) => {",
            "    const value = options.path?.[name];",
            "    if (value === undefined) throw new Error(`Missing path parameter: ${name}`);",
            "    return encodeURIComponent(String(value));",
            "  });",
            "  const query = Object.entries(options.query ?? {}).filter(([, value]) => value !== undefined);",
            "  if (query.length) {",
            "    path += `?${new URLSearchParams(query.map(([key, value]) => [key, String(value)])).toString()}`;",
            "  }",
            "  return { method: operation.method, path, body: options.body };",
            "}",
            "",
            "export function createGeneratedApiClient(",
            "  transport: <T>(request: GeneratedRequest) => Promise<T>,",
            ") {",
            "  return {",
            "    request<T>(operationId: ApiOperationId, options?: GeneratedCallOptions): Promise<T> {",
            "      return transport<T>(resolveGeneratedOperation(operationId, options));",
            "    },",
            "  };",
            "}",
            "",
        ]
    )


def _write_or_check(path: Path, content: str, *, check: bool) -> bool:
    """Write generated content, or return whether the checked-in file matches."""
    if check:
        return path.is_file() and path.read_text(encoding="utf-8") == content
    path.write_text(content, encoding="utf-8")
    return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="fail if checked-in artifacts are stale")
    args = parser.parse_args()
    schema = app.openapi()
    generated = ROOT / "frontend" / "src" / "generated"
    generated.mkdir(parents=True, exist_ok=True)
    outputs = {
        generated / "openapi.json": json.dumps(
            schema, ensure_ascii=False, indent=2, sort_keys=True
        ) + "\n",
        generated / "api-types.ts": render_types(schema),
        generated / "api-client.ts": render_client(schema),
    }
    stale = [path for path, content in outputs.items() if not _write_or_check(path, content, check=args.check)]
    if stale:
        for path in stale:
            print(f"stale generated contract: {path.relative_to(ROOT)}", file=sys.stderr)
        return 1
    print(f"generated {len(schema.get('paths', {}))} paths and "
          f"{len(schema.get('components', {}).get('schemas', {}))} schemas")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
